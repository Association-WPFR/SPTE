{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"skipLibCheck": true
	},
	"include": ["entrypoints/**/*.js", "utils/**/*.js", "wxt.config.js", "vitest.config.js", ".wxt/types/*.d.ts"],
	"exclude": ["node_modules", ".output"]
}
